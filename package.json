{
  "name": "vite-plugin-tsmigrate",
  "version": "0.3.2",
  "description": "A minimal, well-structured Vite 8 plugin (hello world) built with Vite+.",
  "keywords": [
    "plugin",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/web-dev-sam/vite-plugin-tsmigrate#readme",
  "bugs": {
    "url": "https://github.com/web-dev-sam/vite-plugin-tsmigrate/issues"
  },
  "license": "MIT",
  "author": "Samuel Braun <sam@webry.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-dev-sam/vite-plugin-tsmigrate.git"
  },
  "bin": {
    "tsmigrate": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run build:layout && vp pack && vp exec vite build tool",
    "build:layout": "cargo build --manifest-path tool/layout/Cargo.toml --release --target wasm32-unknown-unknown",
    "dev": "vp pack --watch",
    "dev:tool": "vp run build:layout && node scripts/dev.mjs",
    "test": "vp test",
    "check": "vp check",
    "pack:local": "vp run build && vp pm pack --pack-destination .pack",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@vue/content-mapper": "4.0.0-alpha.3",
    "oxc-parser": "^0.144.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.15",
    "typescript-7": "npm:typescript@7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
