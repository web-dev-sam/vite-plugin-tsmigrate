{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev (vben)",
      "detail": "One coordinated dev loop (scripts/dev.mjs): runs the vben playground (plugin API + prebuilt tool on :7357) and the tool-UI HMR server (:7358) together on matching ports. Edit tool/** for live HMR; edit src/** and the app auto-restarts. Open the tool URL it prints.",
      "type": "shell",
      "command": "node scripts/dev.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiMagenta" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Dev (Vuetify)",
      "detail": "Coordinated dev loop against the Vuetify playground (tool-UI HMR + playground). Open the tool URL it prints.",
      "type": "shell",
      "command": "node scripts/dev.mjs",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "TSMIGRATE_PLAYGROUND": "playground-vuetify" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiMagenta" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Dev (shadcn-vue)",
      "detail": "Coordinated dev loop against the shadcn-vue playground (tool-UI HMR + playground). Open the tool URL it prints.",
      "type": "shell",
      "command": "node scripts/dev.mjs",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "TSMIGRATE_PLAYGROUND": "playground-shadcn" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiMagenta" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Playground only (no HMR)",
      "detail": "Run just the vben playground (no tool-UI HMR): the plugin serves the prebuilt dist/client tool on :7357. Pair with 'Build Tool UI' to verify the shipped bundle.",
      "type": "shell",
      "command": "vp dev",
      "options": { "cwd": "${workspaceFolder}/playground" },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "play", "color": "terminal.ansiGreen" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Build Tool UI",
      "detail": "Rebuild the shipped tool bundle into dist/client. Use to verify the no-HMR path: run this, then refresh the plugin's prebuilt tool page on :7357.",
      "type": "shell",
      "command": "vp exec vite build tool",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "icon": { "id": "package", "color": "terminal.ansiCyan" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Test",
      "detail": "vp test (Vitest)",
      "type": "shell",
      "command": "vp test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "icon": { "id": "beaker", "color": "terminal.ansiBlue" },
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Check",
      "detail": "vp check --fix (fmt + lint + types)",
      "type": "shell",
      "command": "vp check --fix",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "icon": { "id": "check-all", "color": "terminal.ansiYellow" },
      "presentation": { "panel": "dedicated" }
    }
  ]
}
