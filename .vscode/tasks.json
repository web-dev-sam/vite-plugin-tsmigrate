{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev",
      "detail": "Playground dev server (vite dev)",
      "type": "shell",
      "command": "vp dev",
      "options": { "cwd": "${workspaceFolder}/playground" },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "play", "color": "terminal.ansiGreen" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Prod",
      "detail": "Playground production build + preview",
      "type": "shell",
      "command": "vp build && vp preview",
      "options": { "cwd": "${workspaceFolder}/playground" },
      "isBackground": true,
      "problemMatcher": [],
      "icon": { "id": "rocket", "color": "terminal.ansiMagenta" },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Test",
      "detail": "vp test (Vitest)",
      "type": "shell",
      "command": "vp test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "icon": { "id": "beaker", "color": "terminal.ansiBlue" },
      "presentation": { "panel": "dedicated" }
    }
  ]
}
